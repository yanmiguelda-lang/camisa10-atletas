generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String               @id @default(cuid())
  name              String
  email             String               @unique
  passwordHash      String
  phone             String?
  createdAt         DateTime             @default(now())
  termsAcceptedAt   DateTime?
  athletes          Athlete[]
  subscriptions     Subscription[]
  passwordResets    PasswordResetRequest[]
}

enum ResetStatus {
  PENDING
  RESOLVED
}

model PasswordResetRequest {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ResetStatus @default(PENDING)
  requestedAt DateTime    @default(now())
  resolvedAt  DateTime?
}

enum Polo {
  SANTANA
  BARUERI
  OSASCO
}

model Athlete {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  birthDate     DateTime
  jerseyNumber  Int?
  polo          Polo
  position      Position?
  photoUrl      String?
  publicSlug    String         @unique
  createdAt     DateTime       @default(now())
  matches       Match[]
  subscriptions Subscription[]
}

enum Position {
  GOLEIRO
  FIXO
  ALA
  PIVO
}

model Match {
  id             String       @id @default(cuid())
  athleteId      String
  athlete        Athlete      @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  date           DateTime
  opponent       String
  goals          Int          @default(0)
  assists        Int          @default(0)
  defensivePlays Int          @default(0)
  position       Position
  notes          String?
  createdAt      DateTime     @default(now())
  photos         MatchPhoto[]

  // ── Estatísticas detalhadas por posição (todas opcionais) ──
  minutes Int? // todas as posições

  // Goleiro
  saves           Int? // defesas
  goalsConceded   Int? // gols sofridos
  savesOneOnOne   Int? // defesas em 1x1
  hardSaves       Int? // defesas difíceis
  passesCompleted Int? // passes certos (goleiro)

  // Fixo
  tackles             Int? // desarmes
  interceptions       Int? // interceptações
  progressivePasses   Int? // passes progressivos
  effectivePressures  Int? // pressões eficientes

  // Ala / Pivô
  shots              Int? // finalizações
  dribblesCompleted  Int? // dribles certos (ala)
  chancesCreated     Int? // chances criadas
  foulsSuffered      Int? // faltas sofridas (pivô)

  // Compartilhados entre posições
  recoveries Int? // recuperações (fixo, ala)
  duelsWon   Int? // duelos ganhos (fixo, ala, pivô)
  ballsLost  Int? // perdas de bola (goleiro, fixo, pivô)
}

model MatchPhoto {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  url     String
}

enum Plan {
  TORCIDA
  CRAQUE
}

enum SubStatus {
  PENDING
  ACTIVE
  EXPIRED
}

model Subscription {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     Athlete   @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  plan        Plan
  status      SubStatus @default(PENDING)
  requestedAt DateTime  @default(now())
  confirmedAt DateTime?
  confirmedBy String?
}
