# Postgres (Vercel Postgres ou Neon — provisionar via dashboard Vercel)
DATABASE_URL="postgresql://user:password@host:5432/camisa10_atletas"

# NextAuth
NEXTAUTH_SECRET="gere com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Vercel Blob (Storage > Blob no dashboard Vercel > gerar token)
BLOB_READ_WRITE_TOKEN=""

# Admin — email que pode confirmar pagamentos PIX em /admin
ADMIN_EMAIL="responsavel@camisa10fc.com.br"

# Chave PIX exibida na tela de assinatura (copia-e-cola do clube)
PIX_KEY="chave-pix-do-clube"
PIX_NOME_BENEFICIARIO="Camisa 10 FC"
